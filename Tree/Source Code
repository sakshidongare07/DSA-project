#include <iostream>
#include <algorithm>
using namespace std;

struct Node {
    int key, height;
    Node *left, *right;
    Node(int k) : key(k), height(1), left(NULL), right(NULL) {}
};

int height(Node* n) { return n ? n->height : 0; }

int balance(Node* n) { return n ? height(n->left) - height(n->right) : 0; }

void update(Node* n) { n->height = 1 + max(height(n->left), height(n->right)); }

// Show the tree sideways (right side on top) with balance factors
void show(Node* n, int space = 0) {
    if (!n) return;
    show(n->right, space + 6);
    cout << string(space, ' ') << n->key << "(bf=" << balance(n) << ")\n";
    show(n->left, space + 6);
}

Node* rotateRight(Node* y) {
    Node* x = y->left;
    y->left = x->right;
    x->right = y;
    update(y);
    update(x);
    return x;
}

Node* rotateLeft(Node* x) {
    Node* y = x->right;
    x->right = y->left;
    y->left = x;
    update(x);
    update(y);
    return y;
}

Node* insert(Node* node, int key) {
    // Normal BST insert
    if (!node) return new Node(key);
    if (key < node->key)      node->left  = insert(node->left, key);
    else if (key > node->key) node->right = insert(node->right, key);
    else return node;                       // no duplicates

    update(node);
    int bf = balance(node);

    // LL case
    if (bf > 1 && key < node->left->key)
        return rotateRight(node);

    // RR case
    if (bf < -1 && key > node->right->key)
        return rotateLeft(node);

    // LR case
    if (bf > 1 && key > node->left->key) {
        node->left = rotateLeft(node->left);
        return rotateRight(node);
    }

    // RL case
    if (bf < -1 && key < node->right->key) {
        cout << "\n*** RL imbalance found at node " << node->key << " ***\n";

        cout << "Balance factors BEFORE rebalancing:\n";
        cout << "  Node " << node->key << "        : " << balance(node) << "\n";
        cout << "  Right child " << node->right->key << " : "
             << balance(node->right) << "\n";

        cout << "\nStep 1: Right rotate on " << node->right->key << "\n";
        node->right = rotateRight(node->right);
        show(node);

        cout << "\nStep 2: Left rotate on " << node->key << "\n";
        Node* newRoot = rotateLeft(node);
        show(newRoot);

        cout << "\nBalance factors AFTER rebalancing:\n";
        cout << "  New root " << newRoot->key << "  : " << balance(newRoot) << "\n";
        cout << "  Left  " << newRoot->left->key << "      : "
             << balance(newRoot->left) << "\n";
        cout << "  Right " << newRoot->right->key << "      : "
             << balance(newRoot->right) << "\n";
        return newRoot;
    }
    return node;
}

void test(int arr[], int n, const char* title) {
    cout << "\n==============================\n";
    cout << title << "\n";
    cout << "==============================\n";
    Node* root = NULL;
    for (int i = 0; i < n; i++) {
        cout << "\nInserting " << arr[i] << "...\n";
        root = insert(root, arr[i]);
    }
    cout << "\nFinal AVL tree:\n";
    show(root);
}

int main() {
    int seq1[] = {10, 30, 20};
    test(seq1, 3, "Test 1: 10, 30, 20");

    // Second RL test: 10 becomes -2, its right child 30 is left-heavy
    int seq2[] = {10, 5, 30, 20, 40, 25};
    test(seq2, 6, "Test 2: 10, 5, 30, 20, 40, 25");

    return 0;
}
