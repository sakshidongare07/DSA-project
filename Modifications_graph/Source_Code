#include <iostream>
#include <vector>
#include <queue>
using namespace std;

vector<int> graph[10];
bool visited[10];
int countVisited = 0;

void DFS(int start) {
    visited[start] = true;
    cout << start << " ";
    countVisited++;

    for (int next : graph[start]) {
        if (!visited[next])
            DFS(next);
    }
}

void BFS(int start, int n) {
    bool seen[10] = {false};
    int level[10];

    for (int i = 0; i < n; i++)
        level[i] = -1;

    queue<int> q;
    q.push(start);
    seen[start] = true;
    level[start] = 0;

    cout << "\nBFS Traversal: ";

    while (!q.empty()) {
        int current = q.front();
        q.pop();
        cout << current << " ";

        for (int next : graph[current]) {
            if (!seen[next]) {
                seen[next] = true;
                level[next] = level[current] + 1;
                q.push(next);
            }
        }
    }

    int reachable = 0;
    cout << "\nReachable vertices and BFS levels:\n";

    for (int i = 0; i < n; i++) {
        if (seen[i]) {
            cout << i << " : Level " << level[i] << "\n";
            reachable++;
        }
    }

    cout << "Reachable vertex count: " << reachable;

    cout << "\nUnreachable vertices: ";
    bool found = false;

    for (int i = 0; i < n; i++) {
        if (!seen[i]) {
            cout << i << " ";
            found = true;
        }
    }

    if (!found)
        cout << "None";
}

int main() {
    int n, e, u, v, start;

    cout << "Enter number of vertices: ";
    cin >> n;

    cout << "Enter number of edges: ";
    cin >> e;

    cout << "Enter edges (u v):\n";

    for (int i = 0; i < e; i++) {
        cin >> u >> v;
        graph[u].push_back(v);
        graph[v].push_back(u);
    }

    cout << "Enter starting vertex: ";
    cin >> start;

    cout << "DFS Traversal: ";
    DFS(start);

    cout << "\nDFS visited count: " << countVisited;

    BFS(start, n);

    cout << "\n";
    return 0;
}
