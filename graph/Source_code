#include <iostream>
#include <vector>
#include <queue>
using namespace std;

vector<int> graph[10];
bool visited[10];
int countVisited = 0;

void DFS(int start) {
    visited[start] = true;
    cout << start << " ";
    countVisited++;

    for (int next : graph[start]) {
        if (!visited[next])
            DFS(next);
    }
}

void BFS(int start) {
    bool seen[10] = {false};
    queue<int> q;

    q.push(start);
    seen[start] = true;

    while (!q.empty()) {
        int current = q.front();
        q.pop();
        cout << current << " ";

        for (int next : graph[current]) {
            if (!seen[next]) {
                seen[next] = true;
                q.push(next);
            }
        }
    }
}

int main() {
    int n, e, u, v, start;

    cout << "Enter number of locations: ";
    cin >> n;

    cout << "Enter number of paths: ";
    cin >> e;

    cout << "Enter paths (u v):\n";
    for (int i = 0; i < e; i++) {
        cin >> u >> v;
        graph[u].push_back(v);
        graph[v].push_back(u);
    }

    cout << "Enter starting location: ";
    cin >> start;

    cout << "DFS Traversal: ";
    DFS(start);

    cout << "\nLocations visited: " << countVisited;

    cout << "\nBFS Traversal: ";
    BFS(start);

    cout << "\n";
    return 0;
}
